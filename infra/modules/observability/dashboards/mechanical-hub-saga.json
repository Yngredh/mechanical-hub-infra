{
  "uid": "mh-saga",
  "title": "Mechanical Hub — Saga",
  "description": "Saga orquestrada (Fase 4): sagas por passo, concluídas × compensadas, descartes pela guarda de passo, outbox pendente e profundidade das filas e DLQs (CloudWatch).",
  "tags": [
    "mechanical-hub",
    "saga",
    "sqs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "query",
        "label": "Namespace",
        "datasource": {
          "type": "prometheus",
          "uid": "mh-prometheus"
        },
        "query": "label_values(kube_pod_info, namespace)",
        "current": {
          "text": "production",
          "value": "production"
        },
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "sort": 1
      },
      {
        "name": "queue",
        "type": "custom",
        "label": "Filas",
        "query": "__QUEUES__",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "dlq",
        "type": "custom",
        "label": "DLQs",
        "query": "__DLQS__",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Sagas",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "No período",
      "description": "Contadores do orchestrator: saga_started_total, saga_finished_total{status}, saga_messages_total{type, outcome} e o gauge saga_active{current_step}.",
      "datasource": {
        "type": "prometheus",
        "uid": "mh-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mh-prometheus"
          },
          "expr": "sum(increase(saga_started_total{namespace=\"$namespace\"}[$__range]))",
          "legendFormat": "Iniciadas",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "mh-prometheus"
          },
          "expr": "sum(increase(saga_finished_total{namespace=\"$namespace\", status=\"COMPLETED\"}[$__range]))",
          "legendFormat": "Concluídas",
          "instant": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "mh-prometheus"
          },
          "expr": "sum(increase(saga_finished_total{namespace=\"$namespace\", status=\"COMPENSATED\"}[$__range]))",
          "legendFormat": "Compensadas",
          "instant": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "mh-prometheus"
          },
          "expr": "sum(increase(saga_messages_total{namespace=\"$namespace\", outcome=\"DISCARDED_STEP_GUARD\"}[$__range]))",
          "legendFormat": "Descartes (guarda de passo)",
          "instant": true
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "mh-prometheus"
          },
          "expr": "sum(saga_active{namespace=\"$namespace\"})",
          "legendFormat": "Ativas agora",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "vertical"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Sagas ativas por passo",
      "description": "Gauge de sagas ativas por currentStep. Uma faixa que só cresce indica sagas presas naquele passo.",
      "datasource": {
        "type": "prometheus",
        "uid": "mh-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mh-prometheus"
          },
          "expr": "sum by (current_step) (saga_active{namespace=\"$namespace\"})",
          "legendFormat": "{{current_step}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Concluídas × compensadas",
      "datasource": {
        "type": "prometheus",
        "uid": "mh-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mh-prometheus"
          },
          "expr": "sum by (status) (increase(saga_finished_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Mensagens processadas por tipo e resultado",
      "datasource": {
        "type": "prometheus",
        "uid": "mh-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mh-prometheus"
          },
          "expr": "sum by (type, outcome) (rate(saga_messages_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{type}} — {{outcome}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Descartes pela guarda de passo",
      "description": "Mensagens fora do passo esperado: duplicatas, fora de ordem ou o stockReserved de outras ordens gerado pelo restoreStock. Esperado em volume baixo; um pico indica problema de ordenação.",
      "datasource": {
        "type": "prometheus",
        "uid": "mh-prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mh-prometheus"
          },
          "expr": "sum by (type) (increase(saga_messages_total{namespace=\"$namespace\", outcome=\"DISCARDED_STEP_GUARD\"}[$__rate_interval]))",
          "legendFormat": "{{type}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Outbox",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Idade da mensagem pendente mais antiga, por serviço",
      "description": "Acima de 60 s o alerta MechanicalHubOutboxPendente dispara.",
      "datasource": {
        "type": "prometheus",
        "uid": "mh-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "mh-prometheus"
          },
          "expr": "max by (service) (outbox_oldest_pending_age_seconds{namespace=\"$namespace\"})",
          "legendFormat": "{{service}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Filas SQS (CloudWatch)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Mensagens visíveis nas filas",
      "datasource": {
        "type": "cloudwatch",
        "uid": "mh-cloudwatch"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "mh-cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "AWS/SQS",
          "metricName": "ApproximateNumberOfMessagesVisible",
          "dimensions": {
            "QueueName": "$queue"
          },
          "matchExact": true,
          "statistic": "Maximum",
          "period": "60",
          "id": "",
          "expression": "",
          "label": "${PROP('Dim.QueueName')}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Mensagens nas DLQs",
      "description": "Qualquer valor acima de zero dispara o alarme <fila>-dlq.fifo-nao-vazia no CloudWatch. Reprocessar com o redrive nativo pelo console.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "mh-cloudwatch"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "mh-cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "AWS/SQS",
          "metricName": "ApproximateNumberOfMessagesVisible",
          "dimensions": {
            "QueueName": "$dlq"
          },
          "matchExact": true,
          "statistic": "Maximum",
          "period": "60",
          "id": "",
          "expression": "",
          "label": "${PROP('Dim.QueueName')}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Idade da mensagem mais antiga nas filas",
      "description": "Fila com mensagem envelhecendo = consumidor parado ou grupo FIFO travado numa mensagem que ainda não foi para a DLQ.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "mh-cloudwatch"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 43
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "mh-cloudwatch"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "default",
          "namespace": "AWS/SQS",
          "metricName": "ApproximateAgeOfOldestMessage",
          "dimensions": {
            "QueueName": "$queue"
          },
          "matchExact": true,
          "statistic": "Maximum",
          "period": "60",
          "id": "",
          "expression": "",
          "label": "${PROP('Dim.QueueName')}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    }
  ]
}
