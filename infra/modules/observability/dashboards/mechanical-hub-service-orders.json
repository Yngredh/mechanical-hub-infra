{
  "uid": "mh-service-orders",
  "title": "Mechanical Hub — Ordens de Serviço",
  "description": "Painéis de negócio exigidos pela Fase 3: volume diário de OS, tempo médio de execução por status e erros de integração. As métricas mechanical_hub_* são contrato com a instrumentação da aplicação (etapa 2 do plano de observabilidade) — até lá os painéis ficam vazios.",
  "tags": ["mechanical-hub", "negocio"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Volume",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "OS criadas (24h)",
      "datasource": { "type": "prometheus", "uid": "mh-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(mechanical_hub_service_orders_created_total[24h]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "OS entregues (24h)",
      "datasource": { "type": "prometheus", "uid": "mh-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(mechanical_hub_service_order_transitions_total{to=\"ENTREGUE\", result=\"success\"}[24h]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "green" }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "OS recusadas pelo cliente (24h)",
      "datasource": { "type": "prometheus", "uid": "mh-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(mechanical_hub_service_order_transitions_total{to=\"RECUSADO\"}[24h]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "orange" }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Transições com erro (24h)",
      "datasource": { "type": "prometheus", "uid": "mh-prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(mechanical_hub_service_order_transitions_total{result=\"error\"}[24h]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Volume diário de ordens de serviço",
      "description": "Exigência direta da Fase 3. Precisa de mais de um dia de retenção no Prometheus para mostrar tendência.",
      "datasource": { "type": "prometheus", "uid": "mh-prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(mechanical_hub_service_orders_created_total[1d]))",
          "legendFormat": "OS criadas"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "axisLabel": "ordens",
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Tempo por status",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Tempo médio de execução por status",
      "description": "Diagnóstico, Execução e Finalização — os três estágios que a Fase 3 pede explicitamente.",
      "datasource": { "type": "prometheus", "uid": "mh-prometheus" },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(mechanical_hub_service_order_status_duration_seconds_sum[1h]))\n  /\nclamp_min(sum by (status) (rate(mechanical_hub_service_order_status_duration_seconds_count[1h])), 0.001)",
          "legendFormat": "{{status}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "axisLabel": "duração média",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "p95 de permanência por status (24h)",
      "datasource": { "type": "prometheus", "uid": "mh-prometheus" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, status) (rate(mechanical_hub_service_order_status_duration_seconds_bucket[24h])))",
          "legendFormat": "{{status}}",
          "instant": true
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "continuous-GrYlRd" }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Erros",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Transições de status recusadas",
      "description": "Transição inválida pedida pela API. É o sinal que alimenta o alerta MechanicalHubFalhaProcessamentoOS.",
      "datasource": { "type": "prometheus", "uid": "mh-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (from, to) (rate(mechanical_hub_service_order_transitions_total{result=\"error\"}[$__rate_interval]))",
          "legendFormat": "{{from}} → {{to}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Erros de integração externa",
      "description": "Falhas nos integradores de e-mail e WhatsApp que notificam o cliente.",
      "datasource": { "type": "prometheus", "uid": "mh-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (integration) (rate(mechanical_hub_integration_errors_total[$__rate_interval]))",
          "legendFormat": "{{integration}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "logs",
      "title": "Logs de erro da aplicação",
      "description": "Cada linha carrega trace_id: clicar leva ao trace correspondente no Tempo.",
      "datasource": { "type": "loki", "uid": "mh-loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 34 },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"mechanical-hub\"} | json | level =~ \"(?i)error|warn\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    }
  ]
}
