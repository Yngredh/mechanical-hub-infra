# Values do OpenTelemetry Collector — gerado por Terraform (templatefile).
#
# Papel: porta de entrada unica da telemetria. A aplicacao e as Lambdas falam
# OTLP com este coletor, e e ele que decide para onde cada sinal vai. Trocar
# Loki, Tempo ou Prometheus por outro backend depois vira uma mudanca neste
# arquivo, sem tocar em codigo de aplicacao — a portabilidade que motivou
# escolher OpenTelemetry na RFC-0004.

mode: deployment
replicaCount: 1

image:
  # A distribuicao `k8s` traz os componentes de Kubernetes ja embutidos
  # (k8sattributes, kubeletstats). A `core` nao os inclui.
  repository: otel/opentelemetry-collector-k8s

presets:
  # Cria o ClusterRole/ClusterRoleBinding que o processor k8sattributes precisa
  # para ler pods e namespaces. E RBAC do Kubernetes, nao IAM da AWS — nao
  # esbarra no guardrail do laboratorio.
  kubernetesAttributes:
    enabled: true

resources:
  requests:
    cpu: 50m
    memory: 128Mi
  limits:
    cpu: 400m
    memory: 384Mi

service:
%{ if http_node_port != null ~}
  type: NodePort
%{ else ~}
  type: ClusterIP
%{ endif ~}

ports:
  otlp:
    enabled: true
    containerPort: 4317
    servicePort: 4317
    protocol: TCP
  otlp-http:
    enabled: true
    containerPort: 4318
    servicePort: 4318
%{ if http_node_port != null ~}
    nodePort: ${http_node_port}
%{ endif ~}
    protocol: TCP
  # Portas de protocolos legados que o chart abre por padrao. Nada neste
  # projeto as usa.
  jaeger-compact:
    enabled: false
  jaeger-thrift:
    enabled: false
  jaeger-grpc:
    enabled: false
  zipkin:
    enabled: false

config:
  receivers:
    otlp:
      protocols:
        grpc:
          endpoint: 0.0.0.0:4317
        http:
          endpoint: 0.0.0.0:4318

  processors:
    # Primeiro da fila de proposito: sob pressao de memoria ele rejeita lotes
    # novos em vez de deixar o coletor ser morto pelo OOM killer. Um coletor
    # que reinicia perde telemetria de todo mundo.
    memory_limiter:
      check_interval: 5s
      limit_percentage: 80
      spike_limit_percentage: 20

    k8sattributes:
      auth_type: serviceAccount
      passthrough: false
      extract:
        metadata:
          - k8s.namespace.name
          - k8s.pod.name
          - k8s.deployment.name
          - k8s.node.name

    resource:
      attributes:
        - key: cluster
          value: ${cluster_name}
          action: upsert
        - key: deployment.environment
          value: ${environment}
          action: upsert

    batch:
      timeout: 10s
      send_batch_size: 1024

  exporters:
    # Metricas -> Prometheus. Empurradas por remote write em vez de expostas
    # para scrape: assim nao e preciso um ServiceMonitor extra so para o
    # proprio coletor.
    prometheusremotewrite:
      endpoint: ${prometheus_url}/api/v1/write
      tls:
        insecure: true
      resource_to_telemetry_conversion:
        enabled: true
      # Explicito porque o nome final da serie depende disto. Com o sufixo
      # ligado, o contador `mechanical_hub_auth_login` que as Lambdas publicam
      # vira `mechanical_hub_auth_login_total` no Prometheus — que e o nome
      # usado nos paineis. Desligar aqui esvaziaria esses paineis sem erro
      # nenhum; publicar ja com `_total` na origem geraria `_total_total`.
      add_metric_suffixes: true

    # Logs -> Loki, pela ingestao OTLP nativa (Loki 3.x). O exporter acrescenta
    # /v1/logs ao endpoint abaixo.
    otlphttp/loki:
      endpoint: ${loki_url}/otlp
      tls:
        insecure: true

    # Traces -> Tempo.
    otlp/tempo:
      endpoint: ${tempo_otlp_grpc}
      tls:
        insecure: true

  extensions:
    health_check:
      endpoint: 0.0.0.0:13133

  service:
    extensions: [health_check]
    pipelines:
      traces:
        receivers: [otlp]
        processors: [memory_limiter, k8sattributes, resource, batch]
        exporters: [otlp/tempo]
      metrics:
        receivers: [otlp]
        processors: [memory_limiter, k8sattributes, resource, batch]
        exporters: [prometheusremotewrite]
      logs:
        receivers: [otlp]
        processors: [memory_limiter, k8sattributes, resource, batch]
        exporters: [otlphttp/loki]
