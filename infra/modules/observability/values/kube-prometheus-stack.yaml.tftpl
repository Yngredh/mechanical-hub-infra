# Values do kube-prometheus-stack — gerado por Terraform (templatefile).
# Nao editar no cluster: qualquer alteracao manual e desfeita no proximo apply.
#
# Os requests/limits sao contidos de proposito: a stack divide os nodes
# t3.large com os 4 servicos e o MongoDB. Ver o cabecalho de
# modules/observability/main.tf.

fullnameOverride: kube-prometheus-stack

# ── Prometheus ───────────────────────────────────────────────────────────────

prometheus:
  prometheusSpec:
    retention: ${metrics_retention}
    scrapeInterval: 30s
    evaluationInterval: 30s

    # Recebe as metricas que o coletor OpenTelemetry empurra por remote write.
    # Sem isso o coletor sobe, mas nada do que ele exporta chega ao Prometheus.
    enableRemoteWriteReceiver: true

    externalLabels:
      cluster: ${cluster_name}
      environment: ${environment}

    # Seletores nulos = o Prometheus adota qualquer ServiceMonitor/PodMonitor/
    # PrometheusRule do cluster, nao so os que tem a label do proprio release.
    # E o que permite a aplicacao declarar seu ServiceMonitor no repositorio
    # mechanical-hub sem conhecer detalhes deste chart.
    serviceMonitorSelectorNilUsesHelmValues: false
    podMonitorSelectorNilUsesHelmValues: false
    ruleSelectorNilUsesHelmValues: false
    probeSelectorNilUsesHelmValues: false
    scrapeConfigSelectorNilUsesHelmValues: false

    # Scrape do /actuator/prometheus dos servicos da Fase 4. Fica aqui, e nao
    # em ServiceMonitor nos repositorios dos servicos, para que um painel nunca
    # fique vazio porque um servico esqueceu o manifesto de monitoramento.
    #
    # Contrato com os manifestos: pod no namespace da aplicacao, label
    # app.kubernetes.io/name (ou app) com o nome do servico, e porta de
    # container chamada `http` ou numero 8080. O label `service` das series
    # e o nome do servico — e por ele que paineis e alertas filtram.
    additionalScrapeConfigs:
      - job_name: mechanical-hub-services
        metrics_path: /actuator/prometheus
        scrape_interval: 30s
        kubernetes_sd_configs:
          - role: pod
            namespaces:
              names: ["${app_namespace}"]
        relabel_configs:
          # Nome do servico: app.kubernetes.io/name, ou `app` se o primeiro
          # nao existir.
          - source_labels: [__meta_kubernetes_pod_label_app]
            target_label: __tmp_service
          - source_labels: [__meta_kubernetes_pod_label_app_kubernetes_io_name]
            regex: (.+)
            target_label: __tmp_service
          - source_labels: [__tmp_service]
            regex: "${service_regex}"
            action: keep
          # Um alvo por pod: so a porta HTTP da aplicacao.
          - source_labels: [__meta_kubernetes_pod_container_port_name, __meta_kubernetes_pod_container_port_number]
            separator: ";"
            regex: "http;.*|.*;8080"
            action: keep
          - source_labels: [__meta_kubernetes_pod_phase]
            regex: Running
            action: keep
          - source_labels: [__tmp_service]
            target_label: service
          - source_labels: [__meta_kubernetes_namespace]
            target_label: namespace
          - source_labels: [__meta_kubernetes_pod_name]
            target_label: pod

%{ if persistence_enabled ~}
    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: ${storage_class}
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              storage: ${prometheus_storage_size}
%{ endif ~}

    # Subiu na Fase 4: 4 servicos raspados em vez de 1 multiplicam as series
    # (JVM, HTTP, outbox, saga).
    resources:
      requests:
        cpu: 300m
        memory: 1Gi
      limits:
        cpu: "1"
        memory: 2Gi

# ── Alertmanager ─────────────────────────────────────────────────────────────
#
# Sobe sem receptor real: os alertas ficam visiveis na UI e no Grafana, mas nao
# saem para lugar nenhum. Escolher o canal de notificacao (webhook, e-mail,
# Slack) e item em aberto do plano de observabilidade — ate la, deixar um
# receptor "null" e mais honesto do que um endpoint que ninguem le.

alertmanager:
  alertmanagerSpec:
    resources:
      requests:
        cpu: 20m
        memory: 64Mi
      limits:
        cpu: 100m
        memory: 128Mi

  config:
    route:
      group_by: ["alertname", "namespace"]
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 4h
      receiver: "null"
      routes:
        - matchers:
            - alertname = "Watchdog"
          receiver: "null"
    receivers:
      - name: "null"

# ── Grafana ──────────────────────────────────────────────────────────────────

grafana:
  adminPassword: ${grafana_admin_password}

  # Sem Ingress: o acesso e por port-forward. Um cluster de laboratorio com
  # credenciais rotativas nao e lugar para uma UI administrativa publica.
  service:
    type: ClusterIP

  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      cpu: 300m
      memory: 384Mi

  sidecar:
    dashboards:
      # O sidecar observa a API do Kubernetes atras de ConfigMaps com a label
      # abaixo e entrega o JSON ao Grafana sem reiniciar o pod. E o mecanismo
      # que torna dashboard-como-codigo possivel.
      enabled: true
      label: grafana_dashboard
      labelValue: "1"
      searchNamespace: ALL
      folderAnnotation: grafana_folder
      provider:
        foldersFromFilesStructure: true
    datasources:
      enabled: true
      # Os datasources vem inteiros de additionalDataSources abaixo, com UID
      # fixo — os JSON dos dashboards referenciam esses UIDs literalmente.
      defaultDatasourceEnabled: false

  additionalDataSources:
    - name: Prometheus
      uid: ${prometheus_datasource_uid}
      type: prometheus
      access: proxy
      url: ${prometheus_url}
      isDefault: true
      jsonData:
        timeInterval: 30s

    - name: Loki
      uid: ${loki_datasource_uid}
      type: loki
      access: proxy
      url: ${loki_url}
      jsonData:
        # Transforma o trace_id que aparece no log em link clicavel para o
        # trace correspondente no Tempo. E o que permite sair de "esta
        # requisicao falhou" para "foi aqui que ela demorou" em um clique.
        #
        # O casamento e por expressao regular sobre a linha, e nao por label:
        # trace_id chega ao Loki como atributo do log (o coletor o extrai do
        # JSON), nao como label de fluxo. Procurar por label nao acharia nada e
        # o link simplesmente nao apareceria — sem erro em lugar nenhum.
        derivedFields:
          - name: TraceID
            matcherType: regex
            matcherRegex: '"trace_id"\s*:\s*"([a-f0-9]+)"'
            datasourceUid: ${tempo_datasource_uid}
            url: "$${__value.raw}"
            urlDisplayLabel: "Ver trace"

    - name: Tempo
      uid: ${tempo_datasource_uid}
      type: tempo
      access: proxy
      url: ${tempo_http_url}
      jsonData:
        # O caminho inverso: de um trace, listar os logs daquela mesma
        # requisicao.
        tracesToLogsV2:
          datasourceUid: ${loki_datasource_uid}
          spanStartTimeShift: "-5m"
          spanEndTimeShift: "5m"
          filterByTraceID: true
          tags:
            - key: service.name
              value: service_name
        serviceMap:
          datasourceUid: ${prometheus_datasource_uid}
        nodeGraph:
          enabled: true

    # Profundidade das filas e DLQs do SQS (ApproximateNumberOfMessagesVisible).
    # Essas metricas so existem no CloudWatch — o Prometheus nao as enxerga.
    #
    # authType default = cadeia padrao do SDK da AWS, que no pod cai nas
    # credenciais da LabRole dos nodes pelo IMDS (hop limit 2, modulo eks).
    # Nenhuma chave em secret: as do Lab expiram a cada sessao.
    - name: CloudWatch
      uid: ${cloudwatch_datasource_uid}
      type: cloudwatch
      access: proxy
      jsonData:
        authType: default
        defaultRegion: ${aws_region}

# ── Exporters de infraestrutura ──────────────────────────────────────────────
#
# Origem das metricas de CPU/memoria do Kubernetes exigidas pela fase:
# node-exporter (metrica do node) e kube-state-metrics (estado dos objetos).

prometheus-node-exporter:
  resources:
    requests:
      cpu: 20m
      memory: 32Mi
    limits:
      cpu: 100m
      memory: 64Mi

kube-state-metrics:
  resources:
    requests:
      cpu: 20m
      memory: 64Mi
    limits:
      cpu: 100m
      memory: 192Mi

prometheusOperator:
  resources:
    requests:
      cpu: 50m
      memory: 96Mi
    limits:
      cpu: 200m
      memory: 256Mi

# ── Componentes indisponiveis no EKS ─────────────────────────────────────────
#
# O control plane do EKS e gerenciado pela AWS e nao expoe estas metricas.
# Deixar ligado gera alerta permanente de target inalcancavel — ruido que
# ensina o time a ignorar alerta, exatamente o oposto do que se quer.

kubeApiServer:
  enabled: true
kubeControllerManager:
  enabled: false
kubeScheduler:
  enabled: false
kubeProxy:
  enabled: false
kubeEtcd:
  enabled: false

# ── Regras de alerta proprias ────────────────────────────────────────────────
#
# Ficam aqui, e nao em recursos `kubernetes_manifest` do tipo PrometheusRule,
# porque aquele recurso exige a CRD ja instalada no momento do plan — o que
# quebraria o primeiro apply, quando a CRD ainda nao existe.
#
# As metricas `mechanical_hub_*`, `outbox_*` e `saga_*` sao o contrato de
# instrumentacao com os servicos. Ate os servicos publica-las, estas regras
# simplesmente nao disparam.

additionalPrometheusRulesMap:
  mechanical-hub:
    groups:
      - name: mechanical-hub-ordens-de-servico
        rules:
          - alert: MechanicalHubFalhaProcessamentoOS
            expr: |
              sum(rate(mechanical_hub_service_order_transitions_total{result="error"}[5m]))
                /
              clamp_min(sum(rate(mechanical_hub_service_order_transitions_total[5m])), 0.001)
                > ${alert_error_rate}
            for: 5m
            labels:
              severity: critical
              component: service-orders
            annotations:
              summary: "Falhas no processamento de ordens de servico"
              description: "{{ $value | humanizePercentage }} das transicoes de status de OS estao falhando nos ultimos 5 minutos."

          - alert: MechanicalHubSemOrdensCriadas
            expr: |
              sum(increase(mechanical_hub_service_orders_created_total[1h])) == 0
            for: 2h
            labels:
              severity: warning
              component: service-orders
            annotations:
              summary: "Nenhuma ordem de servico criada nas ultimas horas"
              description: "Pode ser periodo sem movimento, ou o fluxo de criacao de OS quebrado sem gerar erro."

      - name: mechanical-hub-api
        rules:
          - alert: MechanicalHubLatenciaAlta
            expr: |
              histogram_quantile(
                0.95,
                sum by (le, service, uri) (rate(http_server_requests_seconds_bucket{namespace="${app_namespace}"}[5m]))
              ) > ${alert_latency_seconds}
            for: 10m
            labels:
              severity: warning
              component: api
            annotations:
              summary: "Latencia p95 acima do limite em {{ $labels.service }} {{ $labels.uri }}"
              description: "p95 de {{ $value | humanizeDuration }} em {{ $labels.service }} {{ $labels.uri }} nos ultimos 5 minutos."

          - alert: MechanicalHubTaxaDeErroAlta
            expr: |
              sum by (service) (rate(http_server_requests_seconds_count{namespace="${app_namespace}", status=~"5.."}[5m]))
                /
              clamp_min(sum by (service) (rate(http_server_requests_seconds_count{namespace="${app_namespace}"}[5m])), 0.001)
                > ${alert_error_rate}
            for: 5m
            labels:
              severity: critical
              component: api
            annotations:
              summary: "Taxa de erro 5xx acima do limite em {{ $labels.service }}"
              description: "{{ $value | humanizePercentage }} das respostas de {{ $labels.service }} sao 5xx nos ultimos 5 minutos."

          # Um alerta por servico: com 4 Deployments, somar tudo esconderia um
          # servico inteiro fora do ar enquanto os outros 3 respondem.
          - alert: MechanicalHubServicoIndisponivel
            expr: |
              sum by (deployment) (kube_deployment_status_replicas_available{namespace="${app_namespace}", deployment=~".*(${service_regex}).*"}) == 0
            for: 3m
            labels:
              severity: critical
              component: api
            annotations:
              summary: "{{ $labels.deployment }} sem replicas disponiveis"
              description: "Nenhum pod pronto de {{ $labels.deployment }} no namespace ${app_namespace}."

      # Saga e outbox (Fase 4). As metricas vem dos servicos: outbox_* de todos
      # os 4, saga_* do orchestrator. O alerta de DLQ nao esta aqui: a
      # profundidade das filas so existe no CloudWatch, onde fica o alarme
      # (modulo sqs).
      - name: mechanical-hub-saga
        rules:
          # Linha PENDING antiga no outbox = o relay parou de publicar (fila
          # inacessivel, lider travado). A saga daquele pedido nao anda ate
          # isso ser resolvido; nada e perdido, mas nada avanca
          # (failure_handling.md §4).
          - alert: MechanicalHubOutboxPendente
            expr: |
              max by (service) (outbox_oldest_pending_age_seconds{namespace="${app_namespace}"}) > ${alert_outbox_age_seconds}
            for: 1m
            labels:
              severity: critical
              component: outbox
            annotations:
              summary: "Outbox de {{ $labels.service }} com mensagem pendente ha mais de ${alert_outbox_age_seconds} s"
              description: "A linha PENDING mais antiga do outbox de {{ $labels.service }} tem {{ $value | humanizeDuration }}. O relay nao esta publicando."

      - name: mechanical-hub-autenticacao
        rules:
          - alert: MechanicalHubPicoDeFalhaDeLogin
            expr: |
              sum(rate(mechanical_hub_auth_login_total{result="failed"}[5m])) > 1
            for: 10m
            labels:
              severity: warning
              component: auth
            annotations:
              summary: "Volume incomum de falhas de login"
              description: "{{ $value | printf \"%.2f\" }} falhas de login por segundo — pode ser tentativa de forca bruta ou senha divergente apos deploy."
